# Response headers for Cloudflare Pages (also applied by `python scripts/build_site.py --serve`).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Libraries never change between builds: cache them for a week.
/bridge/vendor/*
  Cache-Control: public, max-age=604800

/learn/vendor/*
  Cache-Control: public, max-age=604800
