# MARINE needs no API keys or secrets: every page is static and all data is
# pre-computed by `python export_web.py` and committed. Never commit a real .env.
#
# Optional build settings for Cloudflare Pages (Settings > Variables and Secrets):
# skip `pip install -r requirements.txt` (Streamlit etc.); the build uses only the standard library.
SKIP_DEPENDENCY_INSTALL=
# Python version for the build image (default 3.13 is fine; 3.9 or newer works).
PYTHON_VERSION=
