{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve website",
      "detail": "Serve web/ at http://localhost:8000 (stop with the trash-can icon)",
      "type": "shell",
      "command": "python -m http.server 8000 --directory web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegin": true, "beginsPattern": "Serving HTTP", "endsPattern": "Serving HTTP" }
      }
    },
    {
      "label": "Export website data",
      "detail": "Re-run every scenario with the Python guard and rewrite web/data/",
      "type": "shell",
      "command": "python export_web.py",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
